[Desktop Entry]
Type=Application
Name=EVSE kiosk
Comment=Charger status display
Exec=sh -c 'until wget -q -O /dev/null http://127.0.0.1:8080/api/v1/status; do sleep 2; done; exec google-chrome --kiosk --incognito --noerrdialogs --disable-infobars --disable-session-crashed-bubble --disable-translate --password-store=basic http://127.0.0.1:8080/'
X-GNOME-Autostart-enabled=true
Hidden=false
NoDisplay=false
