# Written for systemd 229 (Ubuntu 16.04); avoid newer directives.
[Unit]
Description=EVSE charge controller
After=network.target

[Service]
# Logs go to a size-limited file (at most 4 x 10 MB) rather than the journal,
# which Ubuntu forwards to /var/log/syslog. Use `tail -f` on it to follow.
ExecStart=/usr/local/bin/evsectl -config /etc/evse-controller/config.yaml -log-file /var/log/evse-controller/evsectl.log -log-max-mb 10 -log-backups 3
Restart=always
RestartSec=3
User=evse
Group=evse
# Serial ports belong to group dialout.
SupplementaryGroups=dialout
# Uncomment to listen on port 80 as a non-root user.
#AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# ProtectSystem=full makes /etc read-only; the settings page rewrites the config.
ReadWriteDirectories=/etc/evse-controller

[Install]
WantedBy=multi-user.target
